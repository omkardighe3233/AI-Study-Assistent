# Server Port (Render sets this automatically)
PORT=5000

# Environment Mode
NODE_ENV=production

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ai_study_assistant?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string

# JWT Authentication Secrets (Can be generated or random strings)
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Cloudinary Credentials (For PDF uploads & storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Sarvam AI API Key (For AI study assistant features)
SARVAM_API_KEY=your_sarvam_api_key

# Optional: Frontend URL (Only needed if client is hosted separately)
# CLIENT_URL=https://your-frontend-app.onrender.com
